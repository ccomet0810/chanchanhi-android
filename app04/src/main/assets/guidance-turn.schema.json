{
  "type": "object", "additionalProperties": false,
  "properties": {
    "callId": {"type": "string", "minLength": 1, "maxLength": 80},
    "name": {"type": "string", "enum": ["observe", "capture_screen", "list_apps", "update_plan", "open_app", "guide", "ask_user", "finish"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 300},
    "snapshotId": {"type": ["integer", "null"]},
    "nodeId": {"type": ["integer", "null"]},
    "region": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
    "action": {"type": ["string", "null"], "enum": [null, "tap", "long_press", "swipe_up", "swipe_down", "swipe_left", "swipe_right", "input", "adjust", "back", "home", "notifications", "quick_settings"]},
    "instruction": {"type": ["string", "null"], "maxLength": 240},
    "expectedChange": {"type": ["string", "null"], "maxLength": 240},
    "question": {"type": ["string", "null"], "maxLength": 240},
    "options": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "plan": {"type": "array", "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false,
      "properties": {"step": {"type": "string", "minLength": 1, "maxLength": 180}, "status": {"type": "string", "enum": ["pending", "in_progress", "completed"]}},
      "required": ["step", "status"]
    }},
    "evidenceNodeIds": {"type": "array", "maxItems": 12, "items": {"type": "integer"}},
    "packageName": {"type": ["string", "null"], "maxLength": 200}
  },
  "required": ["callId", "name", "summary", "snapshotId", "nodeId", "region", "action", "instruction", "expectedChange", "question", "options", "plan", "evidenceNodeIds", "packageName"]
}
